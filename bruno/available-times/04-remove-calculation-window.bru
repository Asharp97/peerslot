meta {
  name: Remove calculation test window
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/availability-windows/{{calculationWindowId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  origin: {{baseUrl}}
}

tests {
  test("calculation fixture is removed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().deleted).to.equal(true);
  });
}
