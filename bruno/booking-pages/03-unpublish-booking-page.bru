meta {
  name: Unpublish booking page
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/booking-page
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "isPublished": false
  }
}

tests {
  test("provider can unpublish the page", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().bookingPage.isPublished).to.equal(false);
  });
}
