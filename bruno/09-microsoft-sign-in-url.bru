meta {
  name: Get Microsoft sign-in URL
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/sign-in/social
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "microsoft",
    "callbackURL": "http://localhost:3000",
    "disableRedirect": true
  }
}
