meta {
  name: Get Microsoft sign-in URL
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/auth/sign-in/social
  body: json
  auth: none
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "provider": "microsoft",
    "callbackURL": "{{baseUrl}}/en/auth/provider",
    "disableRedirect": true
  }
}

tests {
  test("Microsoft OAuth is configured or explicitly unavailable", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
    if (res.getStatus() === 200) {
      expect(res.getBody().url).to.include("login.microsoftonline.com");
    }
  });
}
