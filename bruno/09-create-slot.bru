meta {
  name: Create provider slot
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/slots
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "startsAt": "{{slotStartsAt}}",
    "endsAt": "{{slotEndsAt}}"
  }
}

script:pre-request {
  const startsAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
  const endsAt = new Date(startsAt.getTime() + 30 * 60 * 1000);
  bru.setVar("slotStartsAt", startsAt.toISOString());
  bru.setVar("slotEndsAt", endsAt.toISOString());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("createdSlotId", res.getBody().slot.id);
  }
}

tests {
  test("JWT reaches the provider capability guard", function () {
    expect(res.getStatus()).to.be.oneOf([201, 403]);
    if (res.getStatus() === 201) {
      expect(res.getBody().slot.startsAt).to.equal(bru.getVar("slotStartsAt"));
    } else {
      expect(res.getBody().error).to.include("providers");
    }
  });
}
