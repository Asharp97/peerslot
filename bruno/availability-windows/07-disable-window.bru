meta {
  name: Disable availability window
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/availability-windows/{{availabilityWindowId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "isActive": false
  }
}

tests {
  test("disabling removes unbooked derived slots", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().window.isActive).to.equal(false);
    expect(res.getBody().slots).to.have.length(0);
  });
}
