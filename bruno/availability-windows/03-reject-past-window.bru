meta {
  name: Reject past availability window
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/availability-windows
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "startsAt": "{{pastStartsAt}}",
    "endsAt": "{{pastEndsAt}}"
  }
}

tests {
  test("past windows are rejected", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("future");
  });
}
