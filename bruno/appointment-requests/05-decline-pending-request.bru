meta {
  name: Decline pending request
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/provider/appointment-requests/{{declinedAppointmentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  { "decision": "decline" }
}

tests {
  test("declines and releases the request", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().appointment.status).to.equal("declined");
  });
}
