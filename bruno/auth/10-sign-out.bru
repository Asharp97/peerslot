meta {
  name: Sign out
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/sign-out
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

headers {
  origin: {{baseUrl}}
  content-type: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("revokedSessionToken", bru.getVar("sessionToken"));
    bru.deleteVar("sessionToken");
  }
}

tests {
  test("session is revoked", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}
