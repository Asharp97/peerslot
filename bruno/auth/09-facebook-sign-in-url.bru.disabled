# Disabled until PeerSlot's future parent company completes Meta Business
# Verification. Rename this file to end in `.bru` when Facebook OAuth is
# re-enabled.

meta {
  name: Get Facebook sign-in URL
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/sign-in/social
  body: json
  auth: none
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "provider": "facebook",
    "callbackURL": "{{baseUrl}}/en/auth/provider",
    "disableRedirect": true
  }
}

tests {
  test("Facebook OAuth is configured or explicitly unavailable", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
    if (res.getStatus() === 200) {
      expect(res.getBody().url).to.include("facebook.com");
    }
  });
}
